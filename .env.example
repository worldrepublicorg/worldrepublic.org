# Database
# Local dev: direct (non-pooled) endpoint — set this when developing locally
DATABASE_URL_LOCAL_DEV=
# Production: pooler endpoint — used on Vercel
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=your_nextauth_secret_here
# Optional canonical URL (not required when hosting multiple domains)
NEXTAUTH_URL=http://localhost:3000
AUTH_WEBAUTHN_RP_NAME=World Republic
# Used by the NextAuth passkey provider (single RPID); keep as your primary domain.
AUTH_WEBAUTHN_RP_ID=www.worldrepublic.org
# Hosts allowed to use passkeys in custom passkey flows
AUTH_WEBAUTHN_ALLOWED_HOSTS=www.worldrepublic.org,www.raisedbyhumanity.org,localhost

# Google OAuth (from Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Thirdweb (from thirdweb.com/dashboard)
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key_here
